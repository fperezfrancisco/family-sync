# ===============================================
# Family Sync - Backend Server Environment Variables
# ===============================================
# 
# Copy this file to .env and update the values
# 
# IMPORTANT: Never commit actual credentials to version control!
# Add .env to your .gitignore file
# ===============================================

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the backend server to run on
PORT=4000

# Environment (development, production, test)
NODE_ENV=development

# =============================================================================
# Database Configuration
# =============================================================================

# MongoDB connection string
# Development: mongodb://localhost:27017/family-sync
# Production: mongodb+srv://username:password@cluster.mongodb.net/database-name
MONGO_URI=mongodb://localhost:27017/family-sync

# =============================================================================
# JWT Authentication
# =============================================================================

# JWT Access Token Secret - Use a strong, random string (32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=your-jwt-access-secret-here-make-it-long-and-random

# JWT Refresh Token Secret - Use a different strong, random string
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-make-it-different-and-random

# Token expiration times (in seconds)
# Access token: 15 minutes (900 seconds)
# Refresh token: 30 days (2592000 seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# =============================================================================
# Socket.IO Configuration
# =============================================================================

# CORS origin for Socket.IO connections
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# =============================================================================
# AWS S3 Configuration (File Upload)
# =============================================================================

# AWS S3 bucket name for storing user uploads (profile pictures, etc.)
BUCKET_NAME=your-s3-bucket-name

# AWS region where your S3 bucket is located
BUCKET_REGION=us-east-1

# AWS IAM access key for S3 operations
# Create an IAM user with S3 permissions and generate access keys
BUCKET_ACCESS_KEY=your-aws-access-key-id

# AWS IAM secret access key for S3 operations
BUCKET_SECRET_ACCESS_KEY=your-aws-secret-access-key

# =============================================================================
# Email Configuration (Future Enhancement)
# =============================================================================

# Email service for notifications and invitations
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Family Sync <noreply@yourdomain.com>

# =============================================================================
# Push Notifications (Future Enhancement)
# =============================================================================

# Firebase Cloud Messaging for push notifications
# FCM_SERVER_KEY=your-fcm-server-key
# FCM_PROJECT_ID=your-firebase-project-id

# =============================================================================
# File Upload Limits
# =============================================================================

# Maximum file size for uploads (in bytes)
# Default: 5MB = 5242880 bytes
# MAX_FILE_SIZE=5242880

# =============================================================================
# Rate Limiting (Future Enhancement)
# =============================================================================

# API rate limiting configuration
# MAX_REQUESTS_PER_MINUTE=100
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Logging Configuration (Future Enhancement)
# =============================================================================

# Log level (error, warn, info, debug)
# LOG_LEVEL=info

# Log file path (optional)
# LOG_FILE=logs/app.log

# =============================================================================
# External API Keys (Future Enhancement)
# =============================================================================

# Google Maps API for location features
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Weather API for event planning
# WEATHER_API_KEY=your-weather-api-key

# =============================================================================
# Security Configuration
# =============================================================================

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Cookie security settings
# COOKIE_SECURE=false  # Set to true in production with HTTPS
# COOKIE_SAME_SITE=lax